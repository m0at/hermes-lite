# Hermes-Lite Environment Configuration
# Copy to .env and fill in your API keys

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Option 1: Anthropic directly
ANTHROPIC_API_KEY=

# Option 2: OpenRouter (access to many providers through one API)
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Default model (override with --model or /model in CLI)
# LLM_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# TERMINAL BACKEND
# =============================================================================
# Backend: "local" (default), "docker", "ssh", "singularity", "modal", "daytona"
# TERMINAL_ENV=local

# Docker
# TERMINAL_DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# SSH
# TERMINAL_SSH_HOST=192.168.1.100
# TERMINAL_SSH_USER=agent
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_KEY=~/.ssh/id_rsa

# Working directory (default: current directory)
# TERMINAL_CWD=.

# Per-command timeout in seconds (default: 60)
TERMINAL_TIMEOUT=60

# =============================================================================
# CONTEXT COMPRESSION
# =============================================================================
# Configured in ~/.hermes-lite/config.yaml under compression:
# CONTEXT_COMPRESSION_ENABLED=true
# CONTEXT_COMPRESSION_THRESHOLD=0.85
